<?xml version="1.0"?>
<package format="3">
  <name>tf_throttle</name>
  <version>0.0.0</version>
  <description>Republishes the simulator's high-rate TF stream at a steady, lower rate</description>

  <maintainer email="e23zhou@watonomous.ca">Eddy Zhou</maintainer>
  <license>Apache2.0</license>

  <!--https://www.ros.org/reps/rep-0149.html#dependency-tags-->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>tf2_msgs</depend>
  <depend>geometry_msgs</depend>

  <!--https://www.ros.org/reps/rep-0149.html#export-->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
